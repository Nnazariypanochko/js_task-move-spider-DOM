"use strict";
var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
wall.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    // Отримуємо ширину рамки динамічно (без хардкоду)
    var style = getComputedStyle(wall);
    var borderWidth = parseFloat(style.borderLeftWidth);
    // Внутрішні розміри "стінки" без рамки
    var wallInnerWidth = wallRect.width - borderWidth * 2;
    var wallInnerHeight = wallRect.height - borderWidth * 2;
    // Координати кліку всередині стінки без рамки
    var clickX = e.clientX - wallRect.left - borderWidth;
    var clickY = e.clientY - wallRect.top - borderWidth;
    var spiderX = clickX - spiderWidth / 2;
    var spiderY = clickY - spiderHeight / 2;
    if (spiderX < 0) spiderX = 0;
    else if (spiderX + spiderWidth > wallInnerWidth) spiderX = wallInnerWidth - spiderWidth;
    if (spiderY < 0) spiderY = 0;
    else if (spiderY + spiderHeight > wallInnerHeight) spiderY = wallInnerHeight - spiderHeight;
